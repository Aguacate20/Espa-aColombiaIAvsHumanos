# ---- Supabase ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave de servicio: SOLO servidor. Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- App ----
# Cambia esto en produccion; protege /api/progress?export=1
EXPORT_TOKEN=pon-aqui-un-token-largo-y-aleatorio

# ---- Registro de NPA (solo España) — SEGUNDO proyecto de Supabase ----
# Base separada: supabase/npa-schema.sql. Si faltan, el registro de NPA se desactiva.
NPA_SUPABASE_URL=https://yyyyyyyyyyyy.supabase.co
NPA_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Firma de los tokens. Cadena larga y aleatoria (p. ej. openssl rand -base64 48).
NPA_TOKEN_SECRET=pon-aqui-otra-cadena-larga-y-aleatoria
